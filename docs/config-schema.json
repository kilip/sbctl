{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kilip/sbctl/internal/config/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "properties": {
        "log": {
          "$ref": "#/$defs/LogConfig"
        },
        "vault": {
          "$ref": "#/$defs/VaultConfig"
        },
        "gitsync": {
          "$ref": "#/$defs/Config"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "log",
        "vault",
        "gitsync"
      ]
    },
    "LogConfig": {
      "properties": {
        "level": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "level",
        "adapter"
      ]
    },
    "VaultConfig": {
      "properties": {
        "dir": {
          "type": "string"
        },
        "user_name": {
          "type": "string"
        },
        "user_email": {
          "type": "string"
        },
        "git_repository": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "dir",
        "user_name",
        "user_email",
        "git_repository"
      ]
    }
  }
}